from src.dtos.post_dto import PostDTO
from src.db.models.post import Post


class PostMapper:

    @staticmethod
    def to_dto(post: Post) -> PostDTO:
        return PostDTO(
            id=post.id,
            usuario_id=post.usuario_id,
            url_imagen=post.url_imagen,
            descripcion=post.descripcion,
            fecha_publicacion=post.fecha_publicacion
        )

    @staticmethod
    def to_model(dto: PostDTO) -> Post:
        return Post(
            usuario_id=dto.usuario_id,
            url_imagen=dto.url_imagen,
            descripcion=dto.descripcion
        )

