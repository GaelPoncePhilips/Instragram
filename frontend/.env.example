# true = backend simulado en memoria (src/mocks). false = backend real en VITE_API_URL.
VITE_USE_MOCK=true
VITE_API_URL=http://localhost:8000/api
# Alternativa sin CORS (recomendada): VITE_API_URL=/api y el proxy de Vite reenvía a BACKEND_URL.
# BACKEND_URL=http://localhost:8000

# Mock: latencia media (ms) y tasa de fallos simulados (0 a 1).
VITE_MOCK_LATENCY_MS=250
VITE_MOCK_FAIL_RATE=0

# TEMPORAL — cada parche responde desde el mock aunque VITE_USE_MOCK=false.
# Ponelo en false cuando el backend real implemente el endpoint (ver docs/TEMPORAL.md).
VITE_TEMPORAL_NOTIFICACIONES=true
VITE_TEMPORAL_BUSQUEDA=true
VITE_TEMPORAL_USUARIOS_POR_ID=true
VITE_TEMPORAL_ALBUM_VIDEO=true
VITE_TEMPORAL_AVATARES=true
VITE_TEMPORAL_GUARDADOS=true
VITE_TEMPORAL_DEV_CUENTAS=true
